{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "win-hip",
      "displayName": "Windows / HIP gfx1201 (clang-cl, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-hip",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "C:/opt/rocm/lib/llvm/bin/clang-cl.exe",
        "CMAKE_LINKER": "C:/opt/rocm/lib/llvm/bin/lld-link.exe",
        "R4D_ROCM_ROOT": "C:/opt/rocm",
        "R4D_GFX_ARCH": "gfx1201",
        "R4DX_BUILD_TESTS": "ON",
        "R4DX_BUILD_SERVER": "ON",
        "R4DX_BUILD_CONVERT": "ON"
      },
      "environment": {
        "HIP_PATH": "C:/opt/rocm",
        "ROCM_PATH": "C:/opt/rocm"
      }
    },
    {
      "name": "win-hip-g128",
      "inherits": "win-hip",
      "displayName": "Windows / HIP gfx1201, w4a16 group 128 (pre-v6 containers)",
      "description": "Same as win-hip but packs and reads w4a16 at the pre-Milestone-11 group of 128 (4.25 bits/weight instead of the default 4.5). qwen38-27b-v5.r4dx and every earlier container were packed at 128, and the default build refuses them by name -- this preset is how you load one without re-converting. Its OWN build dir on purpose: a container is only loadable by binaries built at its group, so the two must never overwrite each other. docs/validation.md 'Milestone 11 / recipe' has the measurements.",
      "binaryDir": "${sourceDir}/build/win-hip-g128",
      "cacheVariables": {
        "R4DX_W4A16_GROUP": "128"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-hip",
      "configurePreset": "win-hip",
      "configuration": "Release"
    },
    {
      "name": "win-hip-g128",
      "configurePreset": "win-hip-g128",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "win-hip",
      "configurePreset": "win-hip",
      "configuration": "Release",
      "environment": {
        "HIP_VISIBLE_DEVICES": "1"
      },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "win-hip-g128",
      "configurePreset": "win-hip-g128",
      "configuration": "Release",
      "environment": {
        "HIP_VISIBLE_DEVICES": "1"
      },
      "output": { "outputOnFailure": true }
    }
  ]
}
